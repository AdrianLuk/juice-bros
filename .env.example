# Copy to `.env` and fill in real values. Never commit `.env`.

# Instagram Graph API (for the recent-posts feed on the Contact page).
# Requires an Instagram Business/Creator account linked to a Facebook Page,
# a Meta developer app, and a long-lived access token.
# https://developers.facebook.com/docs/instagram-platform/instagram-graph-api
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API (podcast video fetch - src/lib/youtube.ts). Replaces the old
# unauthenticated RSS feed so duration + orientation data (needed to tell Shorts
# apart from Episodes) is available; see docs/adr/0001-youtube-data-api-for-shorts-detection.md.
# Create a key in Google Cloud Console: enable "YouTube Data API v3" on a project,
# then Credentials > Create Credentials > API key. Restrict it to that API.
# Blank/missing means "skip the live call" - the site falls back to the committed
# content/videos-fallback.json snapshot either way, so this isn't required for local dev.
YOUTUBE_API_KEY=

# Resend (for the /contact form). https://resend.com
# RESEND_API_KEY: API key from the Resend dashboard.
# CONTACT_FROM_EMAIL: verified sending address (a domain verified in Resend,
#   or their onboarding@resend.dev address for testing before a domain is set up).
# CONTACT_TO_EMAIL: inbox that should receive contact form submissions.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Booking Buddy Reminders (issue #11). Reuses RESEND_API_KEY above.
# REMINDER_FROM_EMAIL: verified sending address for Reminder emails — can be
#   the same as CONTACT_FROM_EMAIL or a distinct one (e.g. reminders@).
# CRON_SECRET: shared secret checked against the `Authorization: Bearer`
#   header on /api/booking-buddy/send-reminders. Vercel Cron sends this
#   header automatically once a project has a CRON_SECRET env var set — see
#   https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs.
#   Any long random string works locally; the route refuses to run without one.
REMINDER_FROM_EMAIL=
CRON_SECRET=

# Booking Buddy web push (issue #12). VAPID identifies this server to push
# services (FCM, Mozilla's push service, etc.) — it is not a third-party API
# key, so it can be generated locally with no account required:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: safe to expose — the browser needs it to call
#   PushManager.subscribe(). Prefixed NEXT_PUBLIC_ deliberately.
# VAPID_PRIVATE_KEY: server-only. Never expose to the browser.
# VAPID_SUBJECT: a mailto: or https: URL identifying the sender, required by
#   the push protocol (e.g. mailto:you@juicebrospickleball.com).
# All three are optional: /api/booking-buddy/send-reminders sends email
# Reminders either way and simply skips the push channel until these are set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Supabase (Booking Buddy only — the marketing/podcast pages need no backend).
# Local dev: run `npx supabase start` and copy the printed values.
# Preview/Production: provisioned by the Supabase integration on the Vercel
# project, not set by hand.
#
# NEXT_PUBLIC_* are exposed to the browser by design; every query they make is
# subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security entirely — never expose to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the local stack, used when running RLS tests
# (`npm run test:rls`).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google Maps Platform (Booking Buddy's Places lookup — issue #18).
# Server-only: never prefix with NEXT_PUBLIC_*, which is the whole point of the
# server-side search (ADR 0005). Restrict the key to the Places API and to this
# app's own origins/IPs in Cloud Console.
GOOGLE_MAPS_API_KEY=
# Optional, test-only. Overrides the Places API host so Playwright can point the
# app at a local fixture server instead of Google. Leave blank in every real
# environment — blank means "use the real API".
GOOGLE_PLACES_API_BASE_URL=

# Booking Buddy email sync (issue #62 / ADR-0009). Reuses the same Google
# Cloud project Supabase's own Google sign-in provider is on, but is a
# separate OAuth client: a Mailbox Link is its own grant, not a Supabase Auth
# session, and needs the `gmail.readonly` Restricted Scope Supabase's client
# never requests. Provision in Cloud Console: OAuth 2.0 Client ID (Web
# application), authorized redirect URI
# `<your-origin>/booking-buddy/settings/gmail-callback`. The consent screen
# stays in Testing mode per ADR-0009 (refresh tokens expire every 7 days) —
# add each approved User as a Cloud Console test user too, separately from
# EMAIL_SYNC_ALLOWLIST below.
GOOGLE_OAUTH_CLIENT_ID=
# Server-only. Never expose to the browser.
GOOGLE_OAUTH_CLIENT_SECRET=
# Server-only. Encrypts mailbox_links.encrypted_refresh_token at rest — see
# token-encryption.ts. Treated as sensitively as SUPABASE_SERVICE_ROLE_KEY.
# Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_LINK_ENCRYPTION_KEY=
# Server-only. Comma-separated Usernames approved for email sync (see
# email-sync-allowlist.ts and ADR-0009's addendum) — deliberately separate
# from Google's own Testing-mode test-user list above. Blank/unset means
# nobody is allowed; the feature fails closed, not open.
EMAIL_SYNC_ALLOWLIST=
# Optional, test-only. Overrides Google's OAuth-flow hosts so Playwright can
# point the app at a local fixture server instead of Google. Leave blank in
# every real environment.
GMAIL_API_BASE_URL=

# Google sign-in (ADR-0013). Client ID Google Identity Services uses to
# render the "Continue with Google" button on the sign-in page — safe to
# expose to the browser (only the Client Secret is sensitive, and this flow
# never uses one). Reuses the same GCP OAuth client Supabase's Google
# provider already holds; see booking-buddy/docs/google-sign-in-setup.md for
# the Cloud Console + Supabase Dashboard steps. Blank/missing means "Continue
# with Google" doesn't render — magic link and password sign-in still work,
# so this is safe to leave unset until that setup is done.
NEXT_PUBLIC_GOOGLE_SIGN_IN_CLIENT_ID=
